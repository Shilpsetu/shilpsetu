# Copy to .env and fill in. Never commit .env.
APP_ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://shilpsetu:shilpsetu@localhost:5432/shilpsetu
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=shilpsetu-media
S3_ACCESS_KEY=shilpsetu
S3_SECRET_KEY=shilpsetu-dev-secret

# --- Provider selection (see ADR-0002) ---------------------------------------
# Profile presets: mock | bhashini | local
# `mock` runs the entire listing flow with no network. This is demo insurance.
PROVIDER_PROFILE=mock

# Per-capability override; leave blank to follow the profile.
PROVIDER_TRANSCRIBER=
PROVIDER_TRANSLATOR=
PROVIDER_WRITER=
PROVIDER_ENHANCER=
PROVIDER_PRICER=

# --- Bhashini (ULCA) ---------------------------------------------------------
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=
